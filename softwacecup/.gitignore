# 环境变量（含密钥，不能提交）
.env
.env.local

# Maven 构建产物
backend/target/
backend/*.log

# Node 依赖与构建产物
frontend/node_modules/
frontend/dist/
frontend/*.log

# 日志文件
*.log
backend-error.log
frontend-error.log

# IDE
.idea/workspace.xml
.idea/dataSources.local.xml
.idea/dataSources/

# 临时文件
temp_patch*.py
test.txt

# 测试产物（含真实 token）
login_response.json

# 应用配置（含密钥默认值，仅允许 .example 模板）
backend/src/main/resources/application.yml
