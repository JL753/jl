# 复制此文件为 .env，填入真实值，不要提交 .env 到 git

# 数据库
DB_URL=jdbc:mysql://127.0.0.1:3306/smartprep?useUnicode=true&characterEncoding=utf-8&serverTimezone=Asia/Shanghai
DB_USERNAME=root
DB_PASSWORD=your_db_password

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# JWT（生产环境务必替换为随机长字符串，可用 openssl rand -base64 64 生成）
JWT_SECRET=your_jwt_secret_change_me
JWT_EXPIRE_HOURS=24

# LLM API Key
LLM_API_KEY=your_llm_api_key
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password

# 百度搜索
BAIDU_SEARCH_TOKEN=your_baidu_search_token

# Docker Compose
MYSQL_ROOT_PASSWORD=your_mysql_root_password
NEO4J_AUTH=neo4j/your_neo4j_password
