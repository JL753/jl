# 复制此文件为 .env，填入真实值，不要提交 .env 到 git

# 数据库
DB_URL=jdbc:mysql://127.0.0.1:3306/smartprep?useUnicode=true&characterEncoding=utf-8&serverTimezone=Asia/Shanghai
DB_USERNAME=root
DB_PASSWORD=root

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# JWT（生产环境务必替换为随机长字符串）
JWT_SECRET=change-me-to-a-random-64-char-string
JWT_EXPIRE_HOURS=24

# 科大讯飞星火大模型 API Key（在讯飞开放平台获取）
LLM_API_KEY=your_apikey_here
LLM_BASE_URL=https://maas-coding-api.cn-huabei-1.xf-yun.com/v2
LLM_MODEL=astron-code-latest
